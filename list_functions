#!/usr/bin/env uv run -s

"""
list_functions.py
Scans .libs/index.yaml and returns a YAML list of available functions.

Usage:
    list_functions
"""

import sys
import yaml
from pathlib import Path


def collect_functions(root: Path = Path(".libs")):
    """
    Load the root index.yaml from .libs and return a list of functions
    with name and description.
    """
    functions = []
    index_path = root / "index.yaml"

    if not index_path.exists():
        return functions

    try:
        with open(index_path, "r") as f:
            data = yaml.safe_load(f) or {}

        for entry in data.get("functions", []):
            func_name = entry.get("name", "")
            func_desc = entry.get("description", "")

            functions.append({
                "name": func_name,
                "description": func_desc
            })
    except Exception as e:
        print(f"error: Error reading {index_path}: {e}", file=sys.stderr)

    return functions


def main():
    """Main entry point."""
    functions = collect_functions()
    print(yaml.dump(functions, default_flow_style=False, sort_keys=False))


if __name__ == "__main__":
    main()
